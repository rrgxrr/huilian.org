# 复制为 .env 后填写
SECRET_KEY=请换成一串很长的随机字符
# 数据库与上传文件位置（默认在 instance/ 目录）
# DATABASE=/data/huilian.sqlite
# UPLOAD_DIR=/data/uploads
BASE_URL=https://huilian.ph
# 正式环境用 HTTPS 时设为 1
SESSION_COOKIE_SECURE=1
# 邮件（不填则只记录在数据库 outbox 表，不真正发出）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HUILIAN <no-reply@huilian.ph>
# Telegram 担保机器人（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=请换成一串随机字符
